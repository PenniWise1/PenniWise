NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/penniwise

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# WhatsApp Business API
WA_ACCESS_TOKEN=replace-with-meta-access-token
WA_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WA_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
WA_APP_SECRET=replace-with-meta-app-secret
WA_API_VERSION=v21.0

# AI Provider
AI_PROVIDER=openai-compatible
AI_API_KEY=replace-with-ai-provider-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=15000

# Security
SALT_ROUNDS=12

# KYC Provider (Smile Identity / Dojah)
# KYC_API_KEY=
# KYC_API_SECRET=

# Broker API (Morgan Capital / Citi Investment)
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_BASE_URL=

# MFB API (Crest / Safe Haven)
# MFB_API_KEY=
# MFB_API_SECRET=
# MFB_BASE_URL=
