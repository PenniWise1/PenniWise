generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
  CLOSED
}

enum RiskProfile {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum AdminRole {
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum KycType {
  BVN
  NIN
  LIVENESS
}

enum KycStatus {
  PENDING
  VERIFIED
  FAILED
}

enum WalletType {
  SAVINGS
  TRADING
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE_BUY
  TRADE_SELL
  SAVINGS_LOCK
  SAVINGS_UNLOCK
  INTEREST_ACCRUAL
  FEE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum SavingsType {
  FLEXIBLE
  LOCKED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  SUBMITTED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  FAILED
}

enum ConversationState {
  IDLE
  ONBOARDING
  AWAITING_BVN
  AWAITING_NIN
  AWAITING_LIVENESS
  AWAITING_RISK_PROFILE
  TRADING
  SAVING
  AWAITING_TRADE_CONFIRM
  ESCALATED_TO_AGENT
}

enum NotificationType {
  TRADE_SETTLED
  PRICE_ALERT
  SAVINGS_NUDGE
  GOAL_REACHED
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}
// ============================================================
// CUSTOMERS  (WhatsApp-identified — no password, ever)
// ============================================================

model User {
  id                  String            @id @default(uuid())
  whatsappNumber      String            @unique @map("whatsapp_number")
  firstName           String?           @map("first_name")
  lastName            String?           @map("last_name")
  email               String?           @unique
  status              UserStatus        @default(PENDING_KYC)
  riskProfile         RiskProfile?      @map("risk_profile")
  cscsAccountNumber   String?           @map("cscs_account_number")
  transactionPinHash  String?           @map("transaction_pin_hash") // bcrypt hash of a 4-6 digit PIN, checked before trades/withdrawals — not a login credential
  conversationState   ConversationState @default(IDLE) @map("conversation_state")
  conversationContext Json?             @map("conversation_context")
  lastInteractionAt   DateTime?         @map("last_interaction_at") // updated on every inbound message — used to detect a stale mid-flow session
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  kycVerifications KycVerification[]
  wallets          Wallet[]
  savingsGoals     SavingsGoal[]
  holdings         Holding[]
  orders           Order[]
  notifications    Notification[]
  priceAlerts      PriceAlert[]
  auditLogs        AuditLog[]
  conversationMessages ConversationMessage[]

  @@index([status])
  @@map("users")
}

// ============================================================
// ADMIN / STAFF  
// ============================================================

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id               String    @id @default(uuid())
  adminId          String    @map("admin_id")
  admin            AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([adminId])
  @@map("admin_sessions")
}

// ============================================================
// KYC — one row per verification type; raw BVN/NIN never stored
// ============================================================

model KycVerification {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          KycType
  status        KycStatus @default(PENDING)
  valueHash     String?   @map("value_hash") // hashed BVN/NIN — never the raw number
  providerRef   String?   @map("provider_ref")
  metadata      Json      @default("{}") // provider response minus any raw PII
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([type, status])
  @@map("kyc_verifications")
}

// ============================================================
// WALLET + LEDGER — balances are derived, never written directly
// ============================================================

model Wallet {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  user          User       @relation(fields: [userId], references: [id])
  type          WalletType
  currency      String     @default("NGN")
  cachedBalance BigInt     @default(0) @map("cached_balance") // minor units — reconciled cache only
  cachedAt      DateTime?  @map("cached_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  ledgerEntries LedgerEntry[]

  @@unique([userId, type, currency])
  @@map("wallets")
}

model Transaction {
  id             String            @id @default(uuid())
  idempotencyKey String            @unique @map("idempotency_key")
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  amount         BigInt // minor units
  currency       String            @default("NGN")
  metadata       Json?
  externalRef    String?           @map("external_ref") // broker/MFB reference
  createdAt      DateTime          @default(now()) @map("created_at")
  completedAt    DateTime?         @map("completed_at")

  ledgerEntries LedgerEntry[]

  @@index([status])
  @@index([type])
  @@map("transactions")
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String          @map("transaction_id")
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  walletId      String          @map("wallet_id")
  wallet        Wallet          @relation(fields: [walletId], references: [id])
  entryType     LedgerEntryType @map("entry_type")
  amount        BigInt // always positive; direction from entryType
  balanceAfter  BigInt          @map("balance_after")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([walletId])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ============================================================
// SAVINGS
// ============================================================

model SavingsGoal {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id])
  name            String
  type            SavingsType
  targetAmount    BigInt?     @map("target_amount")
  targetDate      DateTime?   @map("target_date")
  interestRateBps Int         @map("interest_rate_bps") // basis points
  isLocked        Boolean     @default(false) @map("is_locked")
  lockedUntil     DateTime?   @map("locked_until")
  isCompleted     Boolean     @default(false) @map("is_completed")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("savings_goals")
}

// ============================================================
// MARKET DATA + TRADING
// ============================================================

model Instrument {
  id        String    @id @default(uuid())
  ticker    String    @unique
  name      String
  exchange  String    @default("NGX")
  lastPrice BigInt?   @map("last_price")
  priceAt   DateTime? @map("price_at")

  holdings    Holding[]
  orders      Order[]
  priceAlerts PriceAlert[]

  @@map("instruments")
}

model Holding {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  instrumentId String     @map("instrument_id")
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  quantity     Decimal    @db.Decimal(20, 6)
  avgCost      BigInt     @map("avg_cost")

  @@unique([userId, instrumentId])
  @@map("holdings")
}

model Order {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  user           User        @relation(fields: [userId], references: [id])
  instrumentId   String      @map("instrument_id")
  instrument     Instrument  @relation(fields: [instrumentId], references: [id])
  side           OrderSide
  quantity       Decimal     @db.Decimal(20, 6)
  price          BigInt
  commission     BigInt      @default(0)
  status         OrderStatus @default(PENDING)
  brokerOrderRef String?     @map("broker_order_ref")
  failureReason  String?     @map("failure_reason")
  createdAt      DateTime    @default(now()) @map("created_at")
  filledAt       DateTime?   @map("filled_at")

  @@index([status])
  @@map("orders")
}

// ============================================================
// NOTIFICATIONS + ALERTS
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  channel   String           @default("whatsapp")
  isSent    Boolean          @default(false) @map("is_sent")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@map("notifications")
}

model PriceAlert {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  instrumentId String     @map("instrument_id")
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  targetPrice  BigInt     @map("target_price")
  direction    String // above | below
  isActive     Boolean    @default(true) @map("is_active")
  isTriggered  Boolean    @default(false) @map("is_triggered")
  triggeredAt  DateTime?  @map("triggered_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@index([isActive, isTriggered])
  @@map("price_alerts")
}

model ConversationMessage {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  user              User             @relation(fields: [userId], references: [id])
  direction         MessageDirection
  messageType       String           @map("message_type") // text, interactive, template, system
  content           Json // raw text body, or the interactive reply payload
  whatsappMessageId String?          @map("whatsapp_message_id") // Meta's wamid, for inbound messages
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("conversation_messages")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorType  String   @map("actor_type") // user, admin, system
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
